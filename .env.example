# Copier en .env et changer les secrets avant toute mise en ligne.
POSTGRES_PASSWORD=cinetint
SERVICE_TOKEN=dev-service-token
JWT_SECRET=dev-jwt-secret-a-changer-en-production
GERANT_MOT_DE_PASSE=gerant
CONTROLEUR_MOT_DE_PASSE=controleur

# Port de l'hôte où le proxy nginx publie le site (127.0.0.1 seulement).
# 80 par défaut : http://localhost/. Choisir un port libre si le 80 est pris
# (sur le serveur de production, le nginx de l'hôte l'occupe déjà).
PROXY_PORT=80

# Origines autorisées quand le navigateur appelle un service directement (débogage).
# Par le proxy, tout est de même origine et ce réglage ne sert pas.
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Adresses des services vues par le navigateur.
# Vides (par défaut) : le navigateur appelle tout sur la même origine, c'est-à-dire le proxy,
# qui route /api, /qr et /verification.
URL_API=
URL_QR=
URL_VERIFICATION=

# Ports publiés par docker-compose.debug.yml (débogage seulement)
FRONT_PORT=8080
BACK_PORT=8000
QR_GENERATOR_PORT=8001
QR_VERIFIER_PORT=8002
